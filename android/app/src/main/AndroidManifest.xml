<?xml version="1.0" encoding="utf-8"?>
<!--
    Playback runs entirely on the device: the engine simulates locally and
    never sends anything anywhere.

    INTERNET exists for one job — downloading replays from a repository folder,
    so games produced by a cloud machine reach the phone without a desktop in
    between. It is opt-in and off by default; until it is enabled the app makes
    no network requests at all. Nothing is ever uploaded.

    No storage permissions. Everything on-device is imported through the system
    document picker, which grants access per file without a broad grant.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.OpenBWReplays">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Landscape only: BW's viewport is a wide one, and SDL recreates its
            surface on rotation, which would restart playback.

            The configChanges list matches SDL's own sample project so the
            activity is not torn down for changes SDL handles itself.
        -->
        <activity
            android:name=".ViewerActivity"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.OpenBWReplays.Viewer" />

    </application>

</manifest>
