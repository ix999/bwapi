<?xml version="1.0" encoding="utf-8"?>
<!--
    Laid over SDL's surface. GameTouchView consumes every touch over the game
    and turns it into an explicit engine command, so openbw never receives
    input. Every control the viewer offers — including the replay slider — is
    in this file; openbw's own mouse-driven slider and minimap are switched off
    because the engine no longer sees a mouse.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="false"
    android:focusable="false">

    <!--
        Takes every touch over the game. First child, so the control bars below
        are drawn on top and get touches before it does.
    -->
    <com.openbw.replays.GameTouchView
        android:id="@+id/touch_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Which replay is playing, and the way to change it. -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#80000000"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/replay_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="middle"
            android:singleLine="true"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/toggle_hud"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:minWidth="0dp"
            android:text="@string/viewer_hud"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/pick_replay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:minWidth="0dp"
            android:text="@string/viewer_pick_replay"
            android:textColor="#FFFFFF" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#B0000000"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp">

        <ImageButton
            android:id="@+id/play_pause"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/viewer_play_pause"
            android:src="@android:drawable/ic_media_pause" />

        <!-- Sized for a thumb: the default track is a hard target while scrubbing. -->
        <SeekBar
            android:id="@+id/seek_bar"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <TextView
            android:id="@+id/time_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/speed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:textColor="#FFFFFF" />

        <!--
            Text rather than icons: the framework's +/- drawables are not
            dependable across API levels, and these read fine at button size.
        -->
        <Button
            android:id="@+id/zoom_out"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/viewer_zoom_out"
            android:minWidth="0dp"
            android:text="@string/viewer_zoom_out_label"
            android:textColor="#FFFFFF"
            android:textSize="20sp" />

        <Button
            android:id="@+id/zoom_in"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/viewer_zoom_in"
            android:minWidth="0dp"
            android:text="@string/viewer_zoom_in_label"
            android:textColor="#FFFFFF"
            android:textSize="20sp" />

    </LinearLayout>

</FrameLayout>
